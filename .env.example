# Documentation only. CI reads repository variables and secrets.
JIRA_BASE_URL=https://your-site.atlassian.net
# Required for scoped Jira API tokens; keep JIRA_BASE_URL as the human-facing site URL.
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=DEMO
JIRA_EMAIL=your-bot@example.com
JIRA_API_TOKEN=
OPENAI_API_KEY=
STATE_SIGNING_KEY=
JIRA_APPROVER_IDS=your-jira-account-id
# Optional; otherwise CLI's pinned-version default model is used.
CODEX_MODEL=
